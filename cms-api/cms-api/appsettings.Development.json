{
  "Jwt": {
    // LOCAL DEVELOPMENT ONLY. This value is committed so a fresh clone runs without setup;
    // it is therefore public and must never be reused for a real deployment, which should
    // supply its own key via the Jwt__Key environment variable or a secret store.
    "Key": "dev-only-jwt-signing-key-not-for-production-0123456789"
  },
  "Seed": {
    // Used once, only while the Users table is empty, to create the first Admin.
    "AdminEmail": "admin@cms.local",
    "AdminPassword": "ChangeMe123!"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
